diff --git a/apisix/init.lua b/apisix/init.lua
index b25069c..21b732f 100644
--- a/apisix/init.lua
+++ b/apisix/init.lua
@@ -87,7 +87,17 @@ end
 
 local load_balancer
 local local_conf
-local ver_header = "APISIX/" .. core.version.VERSION
+local ver_header = "agw"
+
+local function set_server_header()
+    if ver_header then
+        core.response.set_header("Server", ver_header)
+    else
+        -- Also clears the built-in Nginx/openresty header generated for this
+        -- response; assigning nil removes the outgoing response header.
+        ngx.header["Server"] = nil
+    end
+end
 
 local has_mod, apisix_ngx_client = pcall(require, "resty.apisix.client")
 
@@ -172,8 +182,13 @@ function _M.http_init_worker()
     control_api_router.init_worker()
     local_conf = core.config.local_conf()
 
-    if local_conf.apisix and local_conf.apisix.enable_server_tokens == false then
-        ver_header = "APISIX"
+    if local_conf.apisix then
+        local server_header = local_conf.apisix.server_header
+        if server_header == false then
+            ver_header = nil
+        elseif type(server_header) == "string" then
+            ver_header = server_header
+        end
     end
 
