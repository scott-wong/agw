+import { describe, expect, it } from 'vitest';
+
+import { getCertificateExpiry } from './certificate';
+
+const utcTimeCertificate = `-----BEGIN CERTIFICATE-----
+MIIBYTCCAQigAwIBAgIUbwD4DQzqTWzr7a6IoXZtrXtV+MgwCgYIKoZIzj0EAwIw
+FzEVMBMGA1UEAwwMYWd3LXV0Yy50ZXN0MB4XDTI2MDEwMTAwMDAwMFoXDTMyMTIz
+MTIzNTk1OVowFzEVMBMGA1UEAwwMYWd3LXV0Yy50ZXN0MFkwEwYHKoZIzj0CAQYI
+KoZIzj0DAQcDQgAEurOe8WEJ/nDJAxbzxoLHF270KGgyywGVkzuvWfRfwuWIz3BB
+0YUdcEoPLdgJCwJB/4N5x5JCnHWCfJSt29qCwaMyMDAwHQYDVR0OBBYEFAhejmEQ
+0dJawsVsuBUdWi9aQNOuMA8GA1UdEwEB/wQFMAMBAf8wCgYIKoZIzj0EAwIDRwAw
+RAIgT49r4hD47uSV1ndIg2gia89VGbg+nOqbpBTz/J5iSngCIFVuYPF1FFFSwwtE
+fqpe61rHZXe7Uee03E2AY7epvIHq
+-----END CERTIFICATE-----`;
+
+const generalizedTimeCertificate = `-----BEGIN CERTIFICATE-----
+MIIBdDCCARqgAwIBAgIUe/iDW5cfDwmmYaP+UjgsJe81ZTYwCgYIKoZIzj0EAwIw
+HzEdMBsGA1UEAwwUYWd3LWdlbmVyYWxpemVkLnRlc3QwIBcNMjYwMTAxMDAwMDAw
+WhgPMjA2MDA2MzAxMjM0NTZaMB8xHTAbBgNVBAMMFGFndy1nZW5lcmFsaXplZC50
+ZXN0MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE7hMVpf2S0h7uR50OO/A4Zc6B
+4+SRDg3qGn398lj+tGzSBQq1TD/IYm0gxCSGxVDZLhWsUKU8FJDjrKq8CtwZYaMy
+MDAwHQYDVR0OBBYEFI0QdVgPGDBs4QetkrSCjDI3BwDEMA8GA1UdEwEB/wQFMAMB
+Af8wCgYIKoZIzj0EAwIDSAAwRQIhAIGhZMu+VxDTEP3VDs8j1Ri8suAGCGXPwqzd
+jqtduvnAAiBCRhqtGU30d6VLBq8Q0XJqcl12D9hm9RpuXPgQ1QL4rg==
+-----END CERTIFICATE-----`;
+
+describe('getCertificateExpiry', () => {
+  it('reads notAfter from a UTCTime certificate', () => {
+    expect(getCertificateExpiry(utcTimeCertificate)?.toISOString()).toBe(
+      '2032-12-31T23:59:59.000Z'
+    );
+  });
+
+  it('reads notAfter from a GeneralizedTime certificate', () => {
+    expect(getCertificateExpiry(generalizedTimeCertificate)?.toISOString()).toBe(
+      '2060-06-30T12:34:56.000Z'
+    );
+  });
+
+  it('uses the primary certificate in a chain', () => {
+    const chain = `${utcTimeCertificate}\n${generalizedTimeCertificate}`;
+    expect(getCertificateExpiry(chain)?.toISOString()).toBe(
+      '2032-12-31T23:59:59.000Z'
+    );
+  });
+
+  it.each([
+    undefined,
+    '',
+    'not a certificate',
+    '-----BEGIN CERTIFICATE-----\nMIIB\n-----END CERTIFICATE-----',
+  ])('returns undefined for invalid input %s', (pem) => {
+    expect(getCertificateExpiry(pem)).toBeUndefined();
+  });
+});
