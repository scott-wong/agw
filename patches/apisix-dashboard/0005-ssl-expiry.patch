+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.
+ * The ASF licenses this file to You under the Apache License, Version 2.0
+ * (the "License"); you may not use this file except in compliance with
+ * the License.  You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+const PEM_CERTIFICATE =
+  /-----BEGIN CERTIFICATE-----([\s\S]*?)-----END CERTIFICATE-----/;
+
+const DER_SEQUENCE = 0x30;
+const DER_INTEGER = 0x02;
+const DER_UTC_TIME = 0x17;
+const DER_GENERALIZED_TIME = 0x18;
+const DER_VERSION = 0xa0;
+
+type DerNode = {
+  tag: number;
+  value: Uint8Array;
+  next: number;
+};
+
+const readNode = (bytes: Uint8Array, offset = 0): DerNode => {
+  if (offset < 0 || offset + 2 > bytes.length) {
+    throw new Error('Truncated DER value');
+  }
+
+  const tag = bytes[offset];
+  let cursor = offset + 1;
+  let length = bytes[cursor];
+  cursor += 1;
+
+  if (length & 0x80) {
+    const octets = length & 0x7f;
+    if (octets === 0 || octets > 4 || cursor + octets > bytes.length) {
+      throw new Error('Invalid DER length');
+    }
+    length = 0;
+    for (let index = 0; index < octets; index += 1) {
+      length = length * 256 + bytes[cursor];
+      cursor += 1;
+    }
+  }
+
+  const end = cursor + length;
+  if (end > bytes.length) {
+    throw new Error('Truncated DER content');
+  }
+
+  return { tag, value: bytes.subarray(cursor, end), next: end };
+};
+
+const decodeBase64 = (value: string) => {
+  const binary = atob(value);
+  const bytes = new Uint8Array(binary.length);
+  for (let index = 0; index < binary.length; index += 1) {
+    bytes[index] = binary.charCodeAt(index);
+  }
+  return bytes;
+};
+
+const decodeAscii = (bytes: Uint8Array) => {
+  let value = '';
+  for (const byte of bytes) {
+    value += String.fromCharCode(byte);
+  }
+  return value;
+};
+
+const parseTime = (node: DerNode) => {
+  const value = decodeAscii(node.value);
+  if (node.tag === DER_UTC_TIME) {
+    const match =
+      /^(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})?(Z|[+-]\d{4})$/.exec(value);
+    if (!match) {
+      throw new Error('Invalid UTCTime');
+    }
+
+    const [, year, month, day, hour, minute, second = '00', zone] = match;
+    const fourDigitYear =
+      Number(year) + (Number(year) >= 50 ? 1900 : 2000);
+    return buildDate(
+      fourDigitYear,
+      month,
+      day,
+      hour,
+      minute,
+      second,
+      zone
+    );
+  }
+
+  if (node.tag === DER_GENERALIZED_TIME) {
+    const match =
+      /^(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})(?:\.\d+)?(Z|[+-]\d{4})$/.exec(
+        value
+      );
+    if (!match) {
+      throw new Error('Invalid GeneralizedTime');
+    }
+
+    const [, year, month, day, hour, minute, second, zone] = match;
+    return buildDate(
+      Number(year),
+      month,
+      day,
+      hour,
+      minute,
+      second,
+      zone
+    );
+  }
+
+  throw new Error('Unsupported X.509 time encoding');
+};
+
+const buildDate = (
+  year: number,
+  month: string,
+  day: string,
+  hour: string,
+  minute: string,
+  second: string,
+  zone: string
+) => {
+  const timestamp = Date.UTC(
+    year,
+    Number(month) - 1,
+    Number(day),
+    Number(hour),
+    Number(minute),
+    Number(second)
+  );
+  const offsetMinutes =
+    zone === 'Z'
+      ? 0
+      : (zone[0] === '+' ? 1 : -1) *
+        (Number(zone.slice(1, 3)) * 60 + Number(zone.slice(3, 5)));
+  const date = new Date(timestamp - offsetMinutes * 60 * 1000);
+  if (Number.isNaN(date.getTime())) {
+    throw new Error('Invalid X.509 time');
+  }
+  return date;
+};
+
+/**
+ * Reads the primary certificate's notAfter value from a PEM certificate or
+ * certificate chain. Returns undefined for empty or malformed input.
+ */
+export const getCertificateExpiry = (pem?: string) => {
+  const match = PEM_CERTIFICATE.exec(pem ?? '');
+  if (!match) {
+    return undefined;
+  }
+
+  try {
+    const bytes = decodeBase64(match[1].replace(/\s+/g, ''));
+    const certificate = readNode(bytes);
+    if (certificate.tag !== DER_SEQUENCE) {
+      return undefined;
+    }
+
+    const tbsCertificate = readNode(certificate.value);
+    if (tbsCertificate.tag !== DER_SEQUENCE) {
+      return undefined;
+    }
+
+    let cursor = 0;
+    let node = readNode(tbsCertificate.value, cursor);
+    cursor = node.next;
+    if (node.tag === DER_VERSION) {
+      node = readNode(tbsCertificate.value, cursor);
+      cursor = node.next;
+    }
+    if (node.tag !== DER_INTEGER) {
+      return undefined;
+    }
+
+    const signature = readNode(tbsCertificate.value, cursor);
+    cursor = signature.next;
+    if (signature.tag !== DER_SEQUENCE) {
+      return undefined;
+    }
+
+    const issuer = readNode(tbsCertificate.value, cursor);
+    cursor = issuer.next;
+    if (issuer.tag !== DER_SEQUENCE) {
+      return undefined;
+    }
+
+    const validity = readNode(tbsCertificate.value, cursor);
+    if (validity.tag !== DER_SEQUENCE) {
+      return undefined;
+    }
+
+    const notBefore = readNode(validity.value);
+    const notAfter = readNode(validity.value, notBefore.next);
+    return parseTime(notAfter);
+  } catch {
+    return undefined;
+  }
+};
