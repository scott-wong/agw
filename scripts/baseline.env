# scripts/baseline.env — AGW 基线唯一事实源（改基线 = 改这里 + `make fetch` 校验 + 换 VERSION）。
# SHA256 与 commit 均为实测登记（git ls-remote / sha256sum）。

# 网关基线：Apache APISIX（关系性表述：based on Apache APISIX）
APISIX_TAG=3.18.0
APISIX_COMMIT=0796d9c2cbedb1f8bf8194292ff526599f4fde20
APISIX_TARBALL_SHA256=5cf1e2b1cf57208b6b4a63cb64a853449501c3c7548348ea9af84cac3f7b0ca5

# 运行时基线：OpenResty release 线（OPENRESTY_SOURCE=master 判非发行）
OPENRESTY_VERSION=1.31.1.1
OPENRESTY_SHA256=65b78baadd3f0984055de89bf13f4a1932e5bfe9c31932037a134ea2b1a0ce42

# TLS 基线：Tongsuo（铜锁）—— 上游 OpenSSL 3.5.4 内核 + 国密 NTLS 双证书。
# 依据 api7/apisix-plugin-gm 的国密构建口径，但改用 Tongsuo-Project 官方仓库
# （api7/tongsuo 已不可用），并锁定 master 上的 commit：master 是分支，
# 分支会前进，commit 不会，故以 commit 为准（verify-baseline 用 tag 8.5.0-pre2 复核）。
TONGSHUO_REPO=https://github.com/Tongsuo-Project/Tongsuo.git
TONGSHUO_REF=master
TONGSHUO_COMMIT=540603a3ff952ce00590bca022015feffbfb7597
TONGSHUO_TAG=8.5.0-pre2
TONGSHUO_VERSION=8.5.0-pre2
TONGSHUO_OPENSSL_VERSION=3.5.4

# 运行时模块（build-apisix-runtime.sh 按此拉取；vendor patch 见 vendor-patches/）
NGX_MULTI_UPSTREAM_MODULE_VERSION=1.3.4
NGX_MULTI_UPSTREAM_MODULE_COMMIT=fc195137f180d8aba27c9eeedf291dd812bf096b
APISIX_NGINX_MODULE_VERSION=1.19.10
APISIX_NGINX_MODULE_COMMIT=c3d122f52a61e4fbc2775c29ce0d8d5e8f80b7a8
WASM_NGINX_MODULE_VERSION=0.7.0
WASM_NGINX_MODULE_COMMIT=0b4b31d6ecfdbc587e8ea455ed6e920a98aadff1
LUA_VAR_NGINX_MODULE_VERSION=v0.5.3
LUA_VAR_NGINX_MODULE_COMMIT=dc04c71e14e8a0407831f9019043d7e6da61b3c3
MOD_DUBBO_VERSION=1.0.2
MOD_DUBBO_COMMIT=4aabf9448fe4a49ca71009af8e03645ee5dadd15
LUA_RESTY_EVENTS_VERSION=0.2.0
LUA_RESTY_EVENTS_COMMIT=8448a92cec36ac04ea522e78f6496ba03c9b1fd8
NGX_HTTP_FFI_CLIENT_VERSION=v0.1.3
NGX_HTTP_FFI_CLIENT_COMMIT=ea8374ddf416ee2553a8aff60189310ca1b6b0c0
