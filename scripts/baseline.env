# Delivery image bases. Tags remain human-readable, while the immutable index
# digest is what the Dockerfile actually consumes.
OPENEULER_BASE_IMAGE=quay.io/openeuler/openeuler
OPENEULER_BASE_TAG=24.03-lts-sp4
OPENEULER_BASE_INDEX_DIGEST=sha256:17c15554be2a5bc46023acb6e04d609d77642b8c20e236e88deb18e41ae4558e
OPENEULER_BASE_AMD64_DIGEST=sha256:ce1e1f9cbb47e90ef4992d6076cce7018d173dbe71cae24d81658cd7335ddb56
OPENEULER_BASE_REF=quay.io/openeuler/openeuler:24.03-lts-sp4@sha256:17c15554be2a5bc46023acb6e04d609d77642b8c20e236e88deb18e41ae4558e

UBUNTU_BASE_IMAGE=ubuntu
UBUNTU_BASE_TAG=24.04
UBUNTU_BASE_INDEX_DIGEST=sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
UBUNTU_BASE_AMD64_DIGEST=sha256:78d4744ead1f5b19b04d0df558ab182a5300903900755e515b2ca4d10eb2044d
UBUNTU_BASE_REF=ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852

# Delivery/test metadata.
AGW_IMAGE_REPOSITORY=ghcr.io/scott-wong/agw
SUPPORTED_PLATFORM=linux/amd64
RUNTIME_USER=root
NGINX_WORKER_USER=nobody

# External-etcd smoke test image.
ETCD_TEST_IMAGE=quay.io/coreos/etcd:v3.5.21
ETCD_TEST_IMAGE_DIGEST=sha256:a3ccd299377af4b9968d8cbaaf9722fe354297f11908f74a846075e1e5f4ee89

# Security tooling. Syft supplies CycloneDX (required for LuaRocks); Trivy is
# the only blocking vulnerability/secret scanner.
SYFT_VERSION=v1.51.1
SYFT_ASSET=syft_1.51.1_linux_amd64.tar.gz
SYFT_SHA256=8fcb33017a0dc1058298c923c436d19dfa68ae93968e0b423248542e3afb9fc3
