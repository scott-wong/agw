# scripts/baseline.env - AGW baseline source of truth.
# Every version, commit, archive hash and base-image digest is verified by
# scripts/verify-baseline.sh before an image build.

# Apache APISIX
APISIX_TAG=3.19.0
APISIX_COMMIT=473043623c161966f3f6ef4e8f12d2d8667a12d2
APISIX_SOURCE_URL=https://github.com/apache/apisix/archive/refs/tags/3.19.0.tar.gz
APISIX_SHA256=8b38c792d7e1de13389ab724b7ad31bc5927d3e391fd085811039515b067b3e8

# API7 runtime build recipe that defines the module combination/configure flags
# consumed by scripts/build-apisix-runtime.sh.
BUILD_TOOLS_TAG=apisix-runtime/1.4.2
BUILD_TOOLS_COMMIT=6aaa033823d3b041952a1da6360b5d11ccb99c08

# OpenResty
OPENRESTY_VERSION=1.31.8.1
OPENRESTY_TAG=v1.31.8.1
OPENRESTY_COMMIT=265baf62de60397452f306d61b168ab2c1809d41
OPENRESTY_SOURCE_URL=https://openresty.org/download/openresty-1.31.8.1.tar.gz
OPENRESTY_SHA256=b569c63b420f80a4ac8466f2deffe73ed93ab760026532e039c3658409a997f4

# Tongsuo (SM2/SM3/SM4 + NTLS). The release tag is pinned by both commit and
# source-archive SHA256. AGW does not claim Tongsuo/OpenSSL CVE parity.
TONGSHUO_REPO=Tongsuo-Project/Tongsuo
TONGSHUO_TAG=8.5.0
TONGSHUO_COMMIT=80cfbe3eb194a4d30da90742273c305ad4d096be
TONGSHUO_VERSION=8.5.0
TONGSHUO_OPENSSL_VERSION=3.5.4
TONGSHUO_SOURCE_URL=https://github.com/Tongsuo-Project/Tongsuo/archive/refs/tags/8.5.0.tar.gz
TONGSHUO_SHA256=505085d457214e5662ea7109c3919fb75f695edf74c91ec6f690da0e58c07dea
TONGSUO_CVE_PARITY=not-audited

# PCRE2 and zlib are built from source and installed below the OpenResty prefix.
PCRE2_VERSION=10.49
PCRE2_TAG=pcre2-10.49
PCRE2_COMMIT=6f9d7c1373262c541324a16a358785b33ef116cf
