# scripts/baseline.env - AGW baseline source of truth.
# Every version, commit, archive hash and base-image digest is verified by
# scripts/verify-baseline.sh before an image build.

# Apache APISIX
APISIX_TAG=3.21.0
APISIX_COMMIT=07446140f87b475330ab86f280b94eaf2aeda020
APISIX_SOURCE_URL=https://github.com/apache/apisix/archive/refs/tags/3.21.0.tar.gz
APISIX_SHA256=05ba75bde7884200ecc6123f3ca32ed035f71b21067de07c16efcc41543f7efd

# APISIX's source archive does not contain the built Admin UI. AGW resolves
# apache/apisix-dashboard master once per build workflow, records the exact
# commit in the image, and builds the UI from that source revision.
APISIX_DASHBOARD_REPO=apache/apisix-dashboard
APISIX_DASHBOARD_REF=master
DASHBOARD_PNPM_VERSION=12.16.1

# API7 runtime build recipe that defines the module combination/configure flags
# consumed by scripts/build-apisix-runtime.sh.
APISIX_RUNTIME_VERSION=1.4.3
APISIX_NGINX_CORE_VERSION=1.31.9
BUILD_TOOLS_TAG=apisix-runtime/1.4.3
BUILD_TOOLS_COMMIT=a582dc4dd467732119f35a05a5ee40b406897b98

# OpenResty
OPENRESTY_VERSION=1.31.8.1
OPENRESTY_TAG=v1.31.8.1
OPENRESTY_COMMIT=265baf62de60397452f306d61b168ab2c1809d41
OPENRESTY_SOURCE_URL=https://openresty.org/download/openresty-1.31.8.1.tar.gz
OPENRESTY_SHA256=b569c63b420f80a4ac8466f2deffe73ed93ab760026532e039c3658409a997f4

# Tongsuo (SM2/SM3/SM4 + NTLS). The release tag is pinned by both commit and
# source-archive SHA256. AGW does not claim Tongsuo/OpenSSL CVE parity.
TONGSHUO_REPO=Tongsuo-Project/Tongsuo
TONGSHUO_TAG=8.5.0
TONGSHUO_COMMIT=80cfbe3eb194a4d30da90742273c305ad4d096be
TONGSHUO_VERSION=8.5.0
TONGSHUO_OPENSSL_VERSION=3.5.4
TONGSHUO_SOURCE_URL=https://github.com/Tongsuo-Project/Tongsuo/archive/refs/tags/8.5.0.tar.gz
TONGSHUO_SHA256=505085d457214e5662ea7109c3919fb75f695edf74c91ec6f690da0e58c07dea
TONGSUO_CVE_PARITY=not-audited

# PCRE2 and zlib are built from source and installed below the OpenResty prefix.
PCRE2_VERSION=10.49
PCRE2_TAG=pcre2-10.49
PCRE2_COMMIT=6f9d7c1373262c541324a16a358785b33ef116cf
PCRE2_SOURCE_URL=https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.49/pcre2-10.49.tar.gz
PCRE2_SHA256=929f0b20e62879252a15886b06c89f1edef61a363cbd5826fb041080a5e557ae

ZLIB_VERSION=1.3.2
ZLIB_SOURCE_URL=https://zlib.net/fossils/zlib-1.3.2.tar.gz
ZLIB_SOURCE_FALLBACK_URL=https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16

# Runtime modules. Tags are paired with commits and GitHub tag-archive hashes.
NGX_MULTI_UPSTREAM_MODULE_REPO=api7/ngx_multi_upstream_module
NGX_MULTI_UPSTREAM_MODULE_TAG=1.4.1
NGX_MULTI_UPSTREAM_MODULE_COMMIT=1271391a52e947b576ecbfced05d8bedcd22d04f
NGX_MULTI_UPSTREAM_MODULE_SHA256=78bed4f621c4d10a8dc3635519e82d4539c17d0f195b2e6a2a391803fbd1c53a

APISIX_NGINX_MODULE_REPO=api7/apisix-nginx-module
APISIX_NGINX_MODULE_TAG=1.20.4
APISIX_NGINX_MODULE_COMMIT=be9b5c53efd60060f75055382dfbfd0ba3b7f3a2
APISIX_NGINX_MODULE_SHA256=e5e77e1b4d858e9e29456fdb641655d4623ff4f6e56390d9bfc88acb8a0e1b5f

WASM_NGINX_MODULE_REPO=api7/wasm-nginx-module
WASM_NGINX_MODULE_TAG=0.7.0
WASM_NGINX_MODULE_COMMIT=0b4b31d6ecfdbc587e8ea455ed6e920a98aadff1
WASM_NGINX_MODULE_SHA256=5ae381c26f11cbfc8b75d41c9fe8c24816142933e0b6ab07fce3b31d39e64c12

# wasm-nginx-module 0.7.0 downloads this C API archive during its normal
# install. AGW stages and verifies it up front so a build never depends on
# an unverified network fetch from a module script.
WASMTIME_C_API_VERSION=v0.38.1
WASMTIME_C_API_ASSET=wasmtime-v0.38.1-x86_64-linux-c-api.tar.xz
WASMTIME_C_API_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v0.38.1/wasmtime-v0.38.1-x86_64-linux-c-api.tar.xz
WASMTIME_C_API_SHA256=686efb2a47eae17e11897c8e18116b38c1515bc2a74464d4d222c6265d1cff30

LUA_VAR_NGINX_MODULE_REPO=api7/lua-var-nginx-module
LUA_VAR_NGINX_MODULE_TAG=v0.5.3
LUA_VAR_NGINX_MODULE_COMMIT=dc04c71e14e8a0407831f9019043d7e6da61b3c3
LUA_VAR_NGINX_MODULE_SHA256=66792871b21d9e81f1ec6f8416bc18878ab28db0fbaad41877a0569e6a5c1b20

MOD_DUBBO_REPO=api7/mod_dubbo
MOD_DUBBO_TAG=1.0.2
MOD_DUBBO_COMMIT=4aabf9448fe4a49ca71009af8e03645ee5dadd15
MOD_DUBBO_SHA256=1fb02fccb89a042ebdd2a0da26c050ea9a3807e75fdbf67e79da91eaea0e6953

LUA_RESTY_EVENTS_REPO=Kong/lua-resty-events
LUA_RESTY_EVENTS_TAG=0.2.0
LUA_RESTY_EVENTS_COMMIT=8448a92cec36ac04ea522e78f6496ba03c9b1fd8
LUA_RESTY_EVENTS_SHA256=accc80ad81c6258bf277f40b4d2feb10099e4d315036a8c285889d3991f9e224

NGX_HTTP_FFI_CLIENT_REPO=api7/ngx_http_ffi_client
NGX_HTTP_FFI_CLIENT_TAG=v0.1.3
NGX_HTTP_FFI_CLIENT_COMMIT=ea8374ddf416ee2553a8aff60189310ca1b6b0c0
NGX_HTTP_FFI_CLIENT_SHA256=072f7be95ca8fcac0f31ec86fffbaa32aaa1e260e6e4b87a0e35d397a2f6630e

LUA_RESTY_LIMIT_TRAFFIC_REPO=api7/lua-resty-limit-traffic
LUA_RESTY_LIMIT_TRAFFIC_TAG=v1.2.0
LUA_RESTY_LIMIT_TRAFFIC_SHA256=aca960438de0476f738280a0e5b81030143b9ab9a393e393ef82b70e112e764d

# LuaRocks bootstrap (also pinned by APISIX 3.19's installer).
LUAROCKS_VERSION=3.12.0
LUAROCKS_SOURCE_URL=https://github.com/luarocks/luarocks/archive/refs/tags/v3.12.0.tar.gz
LUAROCKS_SHA256=745e3c5df2f955ecaf60ba1361cfc224564ef7ec210e9a784a3858ae853e9f7c

# Delivery image bases. Tags remain human-readable, while the immutable index
# digest is what the Dockerfile actually consumes.
OPENEULER_BASE_IMAGE=quay.io/openeuler/openeuler
OPENEULER_BASE_TAG=24.03-lts-sp4
OPENEULER_BASE_INDEX_DIGEST=sha256:cacf1c031180b3a93af04ed775d13f22d88e07339bdeaab5ec01015e7d279a47
OPENEULER_BASE_AMD64_DIGEST=sha256:ba59634a2ef411bee2b2a31b74ab5379e54718c40dda72b72265fd0d04ffa0ab
OPENEULER_BASE_REF=quay.io/openeuler/openeuler:24.03-lts-sp4@sha256:cacf1c031180b3a93af04ed775d13f22d88e07339bdeaab5ec01015e7d279a47

UBUNTU_BASE_IMAGE=ubuntu
UBUNTU_BASE_TAG=24.04
UBUNTU_BASE_INDEX_DIGEST=sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
UBUNTU_BASE_AMD64_DIGEST=sha256:9a04f13b3f80ef056361e30868593b1cfd2279fe19e4081cb93a90bf56819d6a
UBUNTU_BASE_REF=ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b

# Admin UI build-only image. It never enters either final runtime image.
NODE_BASE_IMAGE=node
NODE_BASE_TAG=22-alpine
NODE_BASE_INDEX_DIGEST=sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a
NODE_BASE_AMD64_DIGEST=sha256:12f54cafa58d0e96554ae05871e29663ff7241836377dc9a7916449b8adb062c
NODE_BASE_REF=node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a

# Delivery/test metadata.
AGW_IMAGE_REPOSITORY=ghcr.io/scott-wong/agw
SUPPORTED_PLATFORM=linux/amd64
RUNTIME_USER=root
NGINX_WORKER_USER=nobody

# External-etcd smoke test image.
ETCD_TEST_IMAGE=quay.io/coreos/etcd:v3.5.21
ETCD_TEST_IMAGE_DIGEST=sha256:a3ccd299377af4b9968d8cbaaf9722fe354297f11908f74a846075e1e5f4ee89

# Security tooling. Syft supplies CycloneDX (required for LuaRocks); Trivy is
# the only blocking vulnerability/secret scanner.
SYFT_VERSION=v1.51.1
SYFT_ASSET=syft_1.51.1_linux_amd64.tar.gz
SYFT_SHA256=8fcb33017a0dc1058298c923c436d19dfa68ae93968e0b423248542e3afb9fc3
TRIVY_VERSION=v0.76.1
TRIVY_ASSET=trivy_0.76.1_Linux-64bit.tar.gz
TRIVY_SHA256=c7cbe3137fb8a48a17574bede3dd6beb16742d1e9772929940fc90082c39d9c0

# Exact-digest GHCR tag promotion.
CRANE_VERSION=v0.22.1
CRANE_ASSET=go-containerregistry_Linux_x86_64.tar.gz
CRANE_SHA256=0ab7a1d6932a213aed964ce97666c3077fe691c8606413674a8b3e0b9ec4cda0
