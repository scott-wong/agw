# AGW three-node HA example.
# Copy to .env on every node and set the same NODE1_IP/NODE2_IP/NODE3_IP.

AGW_IMAGE=ghcr.nju.edu.cn/scott-wong/agw:latest-openeuler
ETCD_IMAGE=quay.nju.edu.cn/coreos/etcd:v3.7.3

TZ=Asia/Shanghai

# Listener ports on each host (host network is used).
AGW_HTTP_PORT=80
AGW_HTTPS_PORT=443

# Required secrets. Use the same values on all three nodes.
AGW_ADMIN_KEY=
ETCD_ROOT_PASSWORD=

# Current node identity. Change both values on each host.
NODE_NAME=etcd-1
NODE_IP=

# All three node addresses. Use the same values on all hosts.
NODE1_IP=
NODE2_IP=
NODE3_IP=
