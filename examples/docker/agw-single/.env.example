# AGW single-node example.
# Copy this file to .env and fill in both secrets before startup.

AGW_IMAGE=ghcr.nju.edu.cn/scott-wong/agw:latest-openeuler
ETCD_IMAGE=quay.nju.edu.cn/coreos/etcd:v3.7.3

TZ=Asia/Shanghai

# Listener ports on the host (host network is used).
# Rootless Podman users with the default ip_unprivileged_port_start=1024
# should use 8080/8443 instead of 80/443.
AGW_HTTP_PORT=80
AGW_HTTPS_PORT=443

# Required secrets. Empty values intentionally make Compose fail fast.
AGW_ADMIN_KEY=
ETCD_ROOT_PASSWORD=
